<Window x:Class="ThunderbirdAccounts.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Thunderbird Account Backup &amp; Restore" Width="1160" Height="800" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,26"><TextBlock Text="THUNDERBIRD • ACCOUNT TOOLS" Foreground="#6ED9C4" FontSize="12" FontWeight="Bold"/><TextBlock Text="Dina konton. Redo för nästa start." FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Säkerhetskopiera kontoinställningar och sparade inloggningar — utan e-postmeddelanden." Foreground="#9FB0C2"/><TextBlock x:Name="InstallationText" Foreground="#9FB0C2" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
  <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="10" Padding="20" Margin="0,0,0,20"><StackPanel><DockPanel Margin="0,0,0,10"><TextBlock Text="THUNDERBIRD-PROFIL" Foreground="#9FB0C2" FontSize="12" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Uppdatera" Click="Refresh_Click" Padding="12,7"/><Button Content="Välj profilmapp…" Click="Browse_Click" Padding="12,7"/><Button Content="Välj Thunderbird…" Click="Executable_Click" Padding="12,7" Margin="0"/></StackPanel></DockPanel><ComboBox x:Name="ProfilesBox" SelectionChanged="Profile_Changed" FontSize="14" Padding="8" AutomationProperties.Name="Thunderbird-profil"/></StackPanel></Border>
  <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="10" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><TextBlock Text="Identifierade konton" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="#6ED9C4"/></DockPanel><DataGrid x:Name="AccountsGrid" Grid.Row="1" AutomationProperties.Name="Identifierade e-postkonton"><DataGrid.Columns><DataGridTextColumn Header="Konto / namn" Binding="{Binding Name}" Width="1.1*"/><DataGridTextColumn Header="E-postadress" Binding="{Binding Email}" Width="1.4*"/><DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="70"/><DataGridTextColumn Header="Inkommande" Binding="{Binding Incoming}" Width="*"/><DataGridTextColumn Header="Utgående" Binding="{Binding Outgoing}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Border>
  <StackPanel Grid.Row="3" Margin="0,20,0,18"><StackPanel Orientation="Horizontal"><Button x:Name="BackupButton" Content="Backup Accounts" Click="Backup_Click" Background="#187F70" FontWeight="SemiBold"/><Button x:Name="RestoreButton" Content="Restore Accounts" Click="Restore_Click" FontWeight="SemiBold"/><Button x:Name="LaunchButton" Content="Öppna återställd profil" Click="Launch_Click" Visibility="Collapsed"/></StackPanel><TextBlock Text="Stäng Thunderbird före backup och restore. OAuth kan kräva ny inloggning; Primary Password behålls." Foreground="#9FB0C2" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock Text="POP3: lokalt sparad e-post ingår inte. Automatisk hämtning stängs av vid återställning." Foreground="#E7BD79" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
  <Border Grid.Row="4" Background="#182330" CornerRadius="8" Padding="14"><StackPanel><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10" Foreground="#6ED9C4"/><TextBlock x:Name="StatusText" Text="Redo." TextWrapping="Wrap" Foreground="#BDD0E1"/></StackPanel></Border>
 </Grid>
</Window>
